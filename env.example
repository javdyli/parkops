ADMIN_EMAIL=you@yourdomain.com
ADMIN_PASSWORD=choose-a-long-password
DATA_DIR=./data
PORT=8080
# Every link in emails, texts, QR signs and citations is built from this:
PUBLIC_URL=https://parking.yourdomain.com
# Number of reverse proxies in front of the app (Caddy/nginx = 1). 0 when exposed directly.
TRUST_PROXY=1

# Square (Developer Dashboard > your app > Credentials / Locations)
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
# Default Square Terminal device ID for the exit desk (each location can have its own in Locations → Edit)
SQUARE_TERMINAL_DEVICE_ID=
# Apple Pay: the domain association file from Square (default: DATA_DIR/apple-developer-merchantid-domain-association)
# APPLE_PAY_DOMAIN_FILE=

# Email (one of these)
RESEND_API_KEY=
# SENDGRID_API_KEY=
EMAIL_FROM=Parking <parking@yourdomain.com>

# Texts through Twilio (register A2P 10DLC or a verified toll-free number first)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
TWILIO_DISPLAY_NUMBER=

# Optional
# HEALTH_TOKEN=choose-a-secret   # /health?token=… shows cameras, backups and integration status
# DOMAIN=parking.yourdomain.com  # used by docker-compose.yml / Caddy for HTTPS
# PHOTO_RETENTION_DAYS=90
# BACKUP_KEEP=14
# KEEP_IN_MEMORY_DAYS=90
